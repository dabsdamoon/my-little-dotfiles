  "codex": {
    "marketplaces": {
      "my-little-skills": "https://github.com/dabsdamoon/my-little-skills.git"
    },
    "plugins": {
      "superpowers@openai-curated-remote": true,
      "github@openai-curated": true,
      "google-drive@openai-curated": true,
      "notion@openai-curated": true,
